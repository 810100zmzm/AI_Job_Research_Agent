# 复制成 .env 再填自己的 Key（.env 已被 .gitignore 忽略）。
# 由 python-dotenv 的 load_dotenv() 自动加载；只有加 --llm / --vision / --check-llm 时才会读。
# 已经存在的环境变量优先：.env 不会覆盖它们；日志只打印键名，不回显值。

# 文本层：DeepSeek（--llm，用来生成「最可能被追问的 3 个问题 + 一句话建议」）
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# 多模态层：Qwen-VL（--vision，用来把项目里引用的图片读成文字事实）
# DASHSCOPE_API_KEY 与 QWEN_API_KEY 二选一即可
DASHSCOPE_API_KEY=
# QWEN_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_VL_MODEL=qwen-vl-max

# 可选：请求超时（秒），默认 60
# LLM_TIMEOUT=60

# 记忆 / 知识库：运行时数据默认写到项目根 data/，不要改成 C 盘。
# DATA_DIR=data

# L1 短时记忆：MVP 使用进程内字典；TTL 到期或超过容量会自动淘汰。
# 换 Redis 时只需替换 jd_agent/memory/short_term.py 的实现。
# L1_TTL_SECONDS=1800
# L1_MAX_ITEMS=32

# L2 长时记忆：不填 MONGODB_URI 时，默认使用 data/memory/long_term.jsonl。
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DATABASE=jd_agent

# 知识嵌入：auto 会在有 DASHSCOPE_API_KEY / QWEN_API_KEY 时使用通义，
# 否则离线使用 local-hash；也可显式填 local / qwen。
# EMBEDDING_BACKEND=auto
# QWEN_EMBEDDING_MODEL=text-embedding-v4
# QWEN_EMBEDDING_DIMENSIONS=1024

# 知识索引：不填 QDRANT_URL 时，默认使用 data/knowledge/index.jsonl。
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=job_research_knowledge
