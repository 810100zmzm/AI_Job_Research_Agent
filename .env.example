# 复制成 .env 再填自己的 Key（.env 已被 .gitignore 忽略）。
# 由 python-dotenv 的 load_dotenv() 自动加载；只有加 --llm / --vision / --check-llm 时才会读。
# 已经存在的环境变量优先：.env 不会覆盖它们；日志只打印键名，不回显值。

# 文本层：DeepSeek（--llm，用来生成「最可能被追问的 3 个问题 + 一句话建议」）
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# 多模态层：Qwen-VL（--vision，用来把项目里引用的图片读成文字事实）
# DASHSCOPE_API_KEY 与 QWEN_API_KEY 二选一即可
DASHSCOPE_API_KEY=
# QWEN_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_VL_MODEL=qwen-vl-max

# 可选：请求超时（秒），默认 60
# LLM_TIMEOUT=60
